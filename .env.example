# Required locally and in Vercel Production. These NEXT_PUBLIC values are client-visible.
# Project Settings > Data API: project API URL (not the dashboard URL).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Project Settings > API Keys: publishable key. Never use a secret/service-role key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Legacy alternative only if not using the publishable variable above:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# No server-only secret or app base URL is required. Keep real values in .env.local;
# never commit it. See PHASE9_DEPLOYMENT_CHECKLIST.md for production configuration.
